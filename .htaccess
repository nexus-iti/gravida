Options -Indexes
ServerSignature Off

<FilesMatch "(^\.|\.(sql|md|log|bak|old|orig|swp|ini|conf|ps1|bat|sh|json\.lock)$|^config(\.example)?\.php$|^test-api\.html$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # El control de transporte se realiza en seguridad/bootstrap.php, que puede
    # distinguir una LAN privada de Internet sin forzar un puerto 443 inexistente.
    RewriteRule ^seguridad(/|$) - [F,L]
    # Rutas limpias para las páginas: /pages/home -> /pages/home.html
    RewriteRule ^pages/?$ pages/index.html [L]
    RewriteRule ^pages/([a-z0-9-]+)/?$ pages/$1.html [L]
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$
    RewriteRule ^ - [R=405,L]
</IfModule>

LimitRequestBody 3145728

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://ui-avatars.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # HTML: siempre se revalida (ETag -> 304 sin cuerpo), así un deploy se ve al
    # instante y las páginas apuntan enseguida a los assets con ?v= nuevo.
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # CSS/JS: el ?v= es un hash del contenido (scripts/versionar-assets.mjs), así
    # que la URL cambia con cada cambio y se puede cachear un año sin revalidar.
    # Sin ?v= (enlaces viejos o manuales) queda la revalidación corta.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
