# Configuracion local de NEXUS. Copiar a .env (ignorado por git) y completar.
# La leen config.php (base de datos) y `bun run dev` (servidor de desarrollo).
# Una variable definida en el entorno real gana sobre este archivo.

# --- Base de datos (config.php) ---------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexus
DB_USER=root
DB_PASSWORD=

# --- Servidor de desarrollo (bun run dev) -------------------------------------
# Puerto del portal: http://127.0.0.1:8080/pages/
DEV_PORT=8080
# Puerto del `php -S` interno (por defecto DEV_PORT + 1)
DEV_PHP_PORT=8081
# Ruta a php si no esta en el PATH (en Windows se prueba C:/xampp/php/php.exe)
PHP_BIN=
