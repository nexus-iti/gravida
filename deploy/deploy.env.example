# Copiar al servidor como ~/.config/nexus/deploy.env y hacer chmod 600. NUNCA commitear el real.
# Repo de donde se baja el codigo (necesita una deploy key de solo lectura si es privado).
NEXUS_REPO_URL=git@github.com:nexus-iti/gravida.git
NEXUS_BRANCH=main
# Donde viven src/, releases/, shared/ y el enlace current/ (el DocumentRoot apunta a current).
NEXUS_ROOT=/srv/nexus
# auto | native | podman
NEXUS_MODE=auto
# Grupo con el que corre Apache/php-fpm en Ubuntu.
NEXUS_WEB_GROUP=www-data
NEXUS_KEEP_RELEASES=5
# Opcional: recarga tras cambiar current (limpia opcache), ej. con sudo sin clave solo para esto.
# NEXUS_RELOAD_CMD="sudo -n systemctl reload php8.3-fpm"
# NEXUS_HEALTH_URL=http://127.0.0.1/login.php
# Solo modo podman (rootless no puede usar puertos < 1024):
# NEXUS_FRONT_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexus
DB_USER=nexus_app
# Letras, numeros y . _ @ % + = - (el script lo valida).
DB_PASSWORD=cambiar
# Opcional: si el usuario de la app no existe, el script lo crea con estas credenciales.
# En modo podman DB_ADMIN_PASSWORD es la clave de root de MariaDB del container.
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=
